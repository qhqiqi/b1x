{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "冠英 SKU 主数据 v1.2",
  "description": "v1.2（11-21 17:10）：尺寸口径按产品册表头原文更正为「外弧 × 宽度 × 厚度」（英文 outer arch / width / thickness）。v1.1 误作「宽×长×厚」。",
  "type": "object",
  "required": [
    "sku_id",
    "brand",
    "category",
    "dims",
    "fit_name",
    "provenance"
  ],
  "properties": {
    "sku_id": {
      "type": "string",
      "description": "主键：FIT-<适配名>，同名不同规格加 -2/-3 后缀"
    },
    "brand": {
      "type": "string",
      "default": "冠英"
    },
    "category": {
      "enum": [
        "鼓式",
        "盘式",
        "风电"
      ]
    },
    "fit_name": {
      "type": "string",
      "description": "产品册适配名：解放虎威前A / 汉德桥35T前 / GY1054"
    },
    "position": {
      "enum": [
        "前",
        "后",
        "未知"
      ]
    },
    "abs": {
      "type": "boolean",
      "description": "产品册标注 (ABS)"
    },
    "part_no": {
      "type": [
        "string",
        "null"
      ],
      "description": "冠英型号 GY1054/GYS-143；适配名类记录为 null"
    },
    "dims": {
      "type": "object",
      "description": "产品册表头：外弧×宽度×厚度（/备选厚），单位 mm。外弧 = outer arch，是沿鼓面弧长方向的名义尺寸，不是直径。",
      "required": [
        "raw_text"
      ],
      "properties": {
        "arc_mm": {
          "type": [
            "number",
            "null"
          ],
          "description": "外弧（outer arch）"
        },
        "width_mm": {
          "type": [
            "number",
            "null"
          ],
          "description": "宽度（width，轴向）"
        },
        "thickness_mm": {
          "type": [
            "number",
            "null"
          ],
          "description": "厚度（thickness）"
        },
        "thickness_alt_mm": {
          "type": [
            "number",
            "null"
          ],
          "description": "原文 14/15.5 的备选厚"
        },
        "outer_dia_mm": {
          "type": [
            "number",
            "null"
          ],
          "description": "鼓径/直径，仅图纸类产品有，产品表里为空"
        },
        "raw_text": {
          "type": "string",
          "description": "原文尺寸串，展示与溯源用"
        }
      }
    },
    "material": {
      "enum": [
        "半金属",
        "陶瓷",
        "NAO",
        "石墨",
        "其他",
        "未知"
      ]
    },
    "friction_coef": {
      "type": "object",
      "description": "型号级摩擦系数：资料包里没有，留空。企业级指标见 data/structured/benchmark.json",
      "properties": {
        "nominal": {
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "wear_rate": {
      "type": [
        "string",
        "null"
      ]
    },
    "axle_fit": {
      "type": "array",
      "description": "从适配名推断的车桥（汉德/沃胜/BPW/SAF），空数组=未确认",
      "items": {
        "type": "object",
        "required": [
          "brand"
        ],
        "properties": {
          "brand": {
            "type": "string"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "brake_spec": {
            "type": [
              "string",
              "null"
            ]
          },
          "verified": {
            "type": "boolean"
          }
        }
      }
    },
    "cross_refs": {
      "type": "array",
      "description": "竞品/OE/旧编码，资料包里没有，靠客户反馈补",
      "items": {
        "type": "object",
        "required": [
          "type",
          "code"
        ],
        "properties": {
          "type": {
            "enum": [
              "OE",
              "竞品",
              "旧编码"
            ]
          },
          "code": {
            "type": "string"
          },
          "brand": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "enum": [
              "catalog",
              "客户反馈",
              "历史询价",
              "未知"
            ]
          },
          "verified": {
            "type": "boolean"
          }
        }
      }
    },
    "extras": {
      "type": "object",
      "description": "产品册附列：孔数/数量，位置不固定，原样保留"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "report_id",
          "page"
        ],
        "properties": {
          "report_id": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "snippet": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "产品册",
              "测试报告",
              "企业介绍",
              "其他"
            ]
          }
        }
      }
    },
    "price": {
      "type": [
        "object",
        "null"
      ]
    },
    "stock": {
      "enum": [
        "有货",
        "订制",
        "停产",
        "未知"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_file"
      ],
      "properties": {
        "source_file": {
          "type": "string"
        },
        "source_page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "extracted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "extractor": {
          "enum": [
            "rule_coord",
            "rule_layout",
            "llm_batch",
            "manual",
            "seed"
          ]
        },
        "verified": {
          "type": "boolean"
        },
        "verified_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "_placeholder": {
      "type": "boolean",
      "default": false
    }
  }
}